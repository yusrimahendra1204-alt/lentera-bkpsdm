# ============================================================
# .env — Konfigurasi Environment Sistem Persuratan BKPSDM
# Salin file ini: cp .env.example .env
# JANGAN commit file .env ke Git (sudah ada di .gitignore)
# ============================================================

# Port server
PORT=3000

# ---- Konfigurasi MySQL (LOKAL - XAMPP/MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=          # Kosong jika XAMPP default
DB_NAME=persuratan_bkpsdm

